model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password_hash String
  name          String?
  timezone      String         @default("UTC")
  reminders     Reminder[]
  todos         Todo[]
  conversations Conversation[]
  captures      Capture[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
}
