enum Status {
  active
  inactive
  suspended
  deleted
}

enum Gender {
  male
  female
  other
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  password      String
  first_name    String?
  last_name     String?
  gender        Gender?
  date_of_birth String?

  agent_key_id            String?
  timezone                String     @default("UTC")
  reminders               Reminder[]
  tasks                   Task[]
  accept_terms_conditions Boolean    @default(false)
  status                  Status     @default(active)
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt
}
