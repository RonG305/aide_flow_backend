
model Capture {
  id             String        @id @default(cuid())
  user_id        String
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  kind           CaptureKind
  source         String        @default("upload")
  message_id     String?
  message        Message?      @relation(fields: [message_id], references: [id], onDelete: SetNull)
  uri            String?
  mime_type      String?
  extracted_text String?
  metadata       Json?
  status         CaptureStatus @default(pending)
  error          String?
  reminders      Reminder[]
  todos          Todo[]
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  @@index([user_id, created_at])
  @@index([user_id, status])
}

enum CaptureKind {
  audio
  image
  document
  text
  link
}

enum CaptureStatus {
  pending
  processing
  ready
  failed
}
