model Todo {
  id           String       @id @default(cuid())
  user_id      String
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title        String
  notes        String?
  due_date     DateTime?
  priority     TodoPriority @default(medium)
  status       TodoStatus   @default(pending)
  tags         String[]     @default([])
  completed_at DateTime?
  cancelled_at DateTime?
  source       ActorSource  @default(agent)
  message_id   String?
  message      Message?     @relation(fields: [message_id], references: [id], onDelete: SetNull)
  capture_id   String?
  capture      Capture?     @relation(fields: [capture_id], references: [id], onDelete: SetNull)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@index([user_id, status])
  @@index([user_id, due_date])
  @@index([message_id])
  @@index([capture_id])
}

enum TodoStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TodoPriority {
  low
  medium
  high
  urgent
}
