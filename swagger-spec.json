  "info": {
    "title": "Aide flow Backend",
    "description": "NestJS + Prisma backend for Aide, a self-hosted voice assistant — persists reminders and todos, and powers an on-device LLM agent that reads your schedule, sets reminders, and manages tasks",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          },
          "confirm_password": {
            "type": "string",
            "example": "StrongPass123!"
          },
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ],
            "example": "male"
          },
          "date_of_birth": {
            "type": "string",
            "example": "1995-04-17"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Kampala",
            "default": "UTC"
          },
          "accept_terms_conditions": {
            "type": "boolean",
            "example": true,
            "default": false
          }
        },
        "required": [
          "email",
          "password",
          "confirm_password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ],
            "example": "male"
          },
          "date_of_birth": {
            "type": "string",
            "example": "1995-04-17"
          },
          "timezone": {
            "type": "string",
            "example": "Africa/Kampala",
            "default": "UTC"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
